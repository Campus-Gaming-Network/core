{
  "name": "campus-gaming-network-core",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "workspaces": [
    "apps/web",
    "apps/web-start",
    "apps/docs"
  ],
  "scripts": {
    "check:apps-compose": "node scripts/check_apps_compose.mjs",
    "compose:up": "docker compose up --build",
    "dev:docs": "npm --prefix apps/docs run start",
    "build:docs": "npm --prefix apps/docs run build",
    "serve:docs": "npm --prefix apps/docs run serve",
    "test:e2e:docs": "npm --prefix apps/docs run test:e2e",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:web-start": "npm --prefix apps/web-start run dev",
    "build:web": "npm --prefix apps/web run build",
    "build:web-start": "npm --prefix apps/web-start run build",
    "lint:web": "npm --prefix apps/web run lint",
    "lint:web-start": "npm --prefix apps/web-start run lint",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "typecheck:web-start": "npm --prefix apps/web-start run typecheck",
    "test:web": "npm --prefix apps/web run test",
    "test:web-start": "npm --prefix apps/web-start run test",
    "smoke:web-start": "node scripts/tanstack_start_smoke.mjs",
    "migration:inventory": "node scripts/tanstack_migration_inventory.mjs",
    "test:migration-inventory": "node --test scripts/tanstack_migration_inventory.test.mjs",
    "test:e2e:web": "npm --prefix apps/web run test:e2e",
    "test:e2e:web-start": "npm --prefix apps/web-start run test:e2e",
    "fmt:api": "cd apps/api && api_goroot=$(go env GOROOT) && \"$api_goroot/bin/gofmt\" -w cmd internal",
    "fmt:check:api": "cd apps/api && api_goroot=$(go env GOROOT) && api_unformatted=$(\"$api_goroot/bin/gofmt\" -l cmd internal) && test -z \"$api_unformatted\"",
    "vet:api": "cd apps/api && go vet ./...",
    "test:api": "cd apps/api && go test ./..."
  }
}
