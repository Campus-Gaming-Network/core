# Local Docker Compose defaults
POSTGRES_DB=cgn
POSTGRES_USER=cgn
POSTGRES_PASSWORD=cgn

API_HTTP_ADDR=:8080
API_DB_HOST=postgres
API_DB_PORT=5432
API_DB_CONNECT_TIMEOUT=2s
API_DATABASE_URL=postgres://cgn:cgn@localhost:5432/cgn?sslmode=disable
API_SESSION_COOKIE=cgn_session
API_SESSION_TTL=720h
API_COOKIE_SECURE=false
API_VERIFICATION_TTL=24h
API_RESET_TTL=1h
API_SITE_URL=http://localhost:3000
RESEND_API_KEY=
API_ACCOUNT_EMAIL_FROM=account@campusgamingnetwork.com
API_AUTH_RATE_LIMIT=5
API_AUTH_RATE_WINDOW=15m

WEB_API_INTERNAL_URL=http://api:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SENTRY_DSN=
