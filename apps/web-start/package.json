{
  "name": "@campus-gaming-network/web-start",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "start": "node src/production-preflight.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:dev": "START_BROWSER_RUNTIME=development playwright test"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "nitro": "3.0.260903-beta",
    "oxlint": "1.77.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
