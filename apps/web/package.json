  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tanstack/redact": "0.2.1",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
