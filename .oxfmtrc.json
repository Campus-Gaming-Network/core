{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.output/**",
    "**/.vite/**",
    "**/.cache/**",
    "**/.pnpm-store/**",
    "**/.test-build/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/out/**",
    "**/playwright-report*/**",
    "**/test-results/**",
    "**/routeTree.gen.ts",
    "**/public/school-logos/**",
    "apps/api/internal/schools/bundled_logos.json"
  ],
  "printWidth": 80,
  "sortPackageJson": false
}
